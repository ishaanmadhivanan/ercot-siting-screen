table 'W retiring_mw'
	isHidden

	column 'Capacity retiring by 2030'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W retiring_mw Value' = ```
			SELECTEDVALUE ( 'W retiring_mw'[Capacity retiring by 2030], 0 )
			```
		formatString: 0

	partition 'W retiring_mw' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
