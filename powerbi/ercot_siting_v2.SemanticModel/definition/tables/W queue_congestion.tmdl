table 'W queue_congestion'
	isHidden

	column 'Interconnection queue (negative = fewer is better)'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W queue_congestion Value' = ```
			SELECTEDVALUE ( 'W queue_congestion'[Interconnection queue (negative = fewer is better)], 0 )
			```
		formatString: 0

	partition 'W queue_congestion' = calculated
		mode: import
		source = GENERATESERIES ( -10, 10, 1 )
