table 'W ozone_severity'
	isHidden

	column 'Ozone nonattainment severity'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W ozone_severity Value' = ```
			SELECTEDVALUE ( 'W ozone_severity'[Ozone nonattainment severity], 0 )
			```
		formatString: 0

	partition 'W ozone_severity' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
