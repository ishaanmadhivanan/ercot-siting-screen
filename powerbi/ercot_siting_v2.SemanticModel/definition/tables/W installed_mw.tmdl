table 'W installed_mw'
	isHidden

	column 'Existing generation capacity'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W installed_mw Value' = ```
			SELECTEDVALUE ( 'W installed_mw'[Existing generation capacity], 3 )
			```
		formatString: 0

	partition 'W installed_mw' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
