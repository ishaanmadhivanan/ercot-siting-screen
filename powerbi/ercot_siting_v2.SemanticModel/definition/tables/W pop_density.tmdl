table 'W pop_density'
	isHidden

	column 'Population density'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W pop_density Value' = ```
			SELECTEDVALUE ( 'W pop_density'[Population density], 2 )
			```
		formatString: 0

	partition 'W pop_density' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
