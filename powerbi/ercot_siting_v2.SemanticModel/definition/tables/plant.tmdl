table plant

	column county_fips
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: county_fips

	column plant_code
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: plant_code

	column generator_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: generator_id

	column plant_name
		dataType: string
		summarizeBy: none
		sourceColumn: plant_name

	column technology
		dataType: string
		summarizeBy: none
		sourceColumn: technology

	column nameplate_mw
		dataType: double
		formatString: #,##0.0
		summarizeBy: sum
		sourceColumn: nameplate_mw

	column operating_year
		dataType: int64
		summarizeBy: none
		sourceColumn: operating_year

	column latitude
		dataType: double
		dataCategory: Latitude
		summarizeBy: none
		sourceColumn: latitude

	column longitude
		dataType: double
		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: longitude



	partition plant = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerName, DatabaseName),
					View = Source{[Schema = "rpt", Item = "pbi_plant"]}[Data],
					Kept = Table.SelectColumns(View, {"county_fips", "plant_code", "generator_id", "plant_name", "technology", "nameplate_mw", "operating_year", "latitude", "longitude"}),
					Typed = Table.TransformColumnTypes(Kept, {{"county_fips", type text},{"plant_code", Int64.Type},{"generator_id", type text},{"plant_name", type text},{"technology", type text},{"nameplate_mw", type number},{"operating_year", Int64.Type},{"latitude", type number},{"longitude", type number}})
				in
					Typed

