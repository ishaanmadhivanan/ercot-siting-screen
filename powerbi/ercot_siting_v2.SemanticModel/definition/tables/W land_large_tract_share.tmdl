table 'W land_large_tract_share'
	isHidden

	column 'Share of land in large tracts'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W land_large_tract_share Value' = ```
			SELECTEDVALUE ( 'W land_large_tract_share'[Share of land in large tracts], 0 )
			```
		formatString: 0

	partition 'W land_large_tract_share' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
