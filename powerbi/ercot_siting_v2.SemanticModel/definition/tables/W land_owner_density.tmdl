table 'W land_owner_density'
	isHidden

	column 'Landowner density'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W land_owner_density Value' = ```
			SELECTEDVALUE ( 'W land_owner_density'[Landowner density], 0 )
			```
		formatString: 0

	partition 'W land_owner_density' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
