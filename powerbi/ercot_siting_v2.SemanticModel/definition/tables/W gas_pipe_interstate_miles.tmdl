table 'W gas_pipe_interstate_miles'
	isHidden

	column 'Interstate gas pipe'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W gas_pipe_interstate_miles Value' = ```
			SELECTEDVALUE ( 'W gas_pipe_interstate_miles'[Interstate gas pipe], 0 )
			```
		formatString: 0

	partition 'W gas_pipe_interstate_miles' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
