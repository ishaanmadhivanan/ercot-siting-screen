table 'W gas_pipe_miles'
	isHidden

	column 'Gas transmission pipe'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W gas_pipe_miles Value' = ```
			SELECTEDVALUE ( 'W gas_pipe_miles'[Gas transmission pipe], 0 )
			```
		formatString: 0

	partition 'W gas_pipe_miles' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
