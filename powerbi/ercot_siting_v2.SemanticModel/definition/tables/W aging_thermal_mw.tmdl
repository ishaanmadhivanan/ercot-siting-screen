table 'W aging_thermal_mw'
	isHidden

	column 'Gas and coal 40+ years old'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W aging_thermal_mw Value' = ```
			SELECTEDVALUE ( 'W aging_thermal_mw'[Gas and coal 40+ years old], 5 )
			```
		formatString: 0

	partition 'W aging_thermal_mw' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
