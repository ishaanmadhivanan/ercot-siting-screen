table metric

	column metric_key
		dataType: string
		summarizeBy: none
		sourceColumn: metric_key

	column label
		dataType: string
		summarizeBy: none
		sourceColumn: label

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column metric_type
		dataType: string
		summarizeBy: none
		sourceColumn: metric_type

	column unit
		dataType: string
		summarizeBy: none
		sourceColumn: unit

	column better_direction
		dataType: string
		summarizeBy: none
		sourceColumn: better_direction

	column source_name
		dataType: string
		summarizeBy: none
		sourceColumn: source_name

	column data_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: data_date

	column caveat
		dataType: string
		summarizeBy: none
		sourceColumn: caveat



	partition metric = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerName, DatabaseName, [Query = "SELECT metric_key, label, category, metric_type, unit, better_direction, source_name, data_date, caveat FROM dim.metric"]),
					Typed = Table.TransformColumnTypes(Source, {{"metric_key", type text},{"label", type text},{"category", type text},{"metric_type", type text},{"unit", type text},{"better_direction", type text},{"source_name", type text},{"data_date", type date},{"caveat", type text}})
				in
					Typed

