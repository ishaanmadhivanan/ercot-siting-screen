table metric

	column metric_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: metric_key

	column label
		dataType: string
		summarizeBy: none
		sourceColumn: label

	column category
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: category

	column pillar
		dataType: string
		summarizeBy: none
		sourceColumn: pillar

	column metric_type
		dataType: string
		summarizeBy: none
		sourceColumn: metric_type

	column unit
		dataType: string
		summarizeBy: none
		sourceColumn: unit

	column better_direction
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: better_direction

	column source_name
		dataType: string
		summarizeBy: none
		sourceColumn: source_name

	column data_date
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: data_date

	column caveat
		dataType: string
		summarizeBy: none
		sourceColumn: caveat



	partition metric = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerName, DatabaseName),
					View = Source{[Schema = "rpt", Item = "pbi_metric"]}[Data],
					Kept = Table.SelectColumns(View, {"metric_key", "label", "category", "pillar", "metric_type", "unit", "better_direction", "source_name", "data_date", "caveat"}),
					Typed = Table.TransformColumnTypes(Kept, {{"metric_key", type text},{"label", type text},{"category", type text},{"pillar", type text},{"metric_type", type text},{"unit", type text},{"better_direction", type text},{"source_name", type text},{"data_date", type date},{"caveat", type text}})
				in
					Typed

