table 'W land_parcels_500ac'
	isHidden

	column 'Parcels of 500+ acres'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W land_parcels_500ac Value' = ```
			SELECTEDVALUE ( 'W land_parcels_500ac'[Parcels of 500+ acres], 0 )
			```
		formatString: 0

	partition 'W land_parcels_500ac' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
