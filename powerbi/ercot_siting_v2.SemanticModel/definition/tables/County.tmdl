table County

	column county_fips
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: county_fips

	column county_name
		dataType: string
		summarizeBy: none
		sourceColumn: county_name

	column map_label
		dataType: string
		dataCategory: County
		isHidden
		summarizeBy: none
		sourceColumn: map_label

	column population
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: population

	column land_area_sqmi
		dataType: double
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: land_area_sqmi

	column ozone_class
		dataType: string
		summarizeBy: none
		sourceColumn: ozone_class

	column nox_offset_ratio
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: nox_offset_ratio

	column nox_offset_cost_per_tpy
		dataType: double
		formatString: $#,##0
		summarizeBy: none
		sourceColumn: nox_offset_cost_per_tpy

	column nox_credit_trades
		dataType: double
		summarizeBy: none
		sourceColumn: nox_credit_trades

	column land_parcel_coverage
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: land_parcel_coverage

	column land_industrial_acres
		dataType: double
		summarizeBy: none
		sourceColumn: land_industrial_acres

	column lng_terminal_count
		dataType: double
		summarizeBy: none
		sourceColumn: lng_terminal_count

	column 'Ozone Status' = IF ( County[ozone_class] = "Attainment", "Attainment", "Nonattainment" )
		dataType: string
		summarizeBy: none


	/// Reads the slider for whichever pillar is in the current row. Used by My Score.
	measure 'Weight For Pillar' = ```
			SWITCH (
			    SELECTEDVALUE ( county_factor_score[pillar] ),
			        "Gas supply", [W gas Value],
			        "Grid connection", [W grid Value],
			        "Site control", [W site Value],
			        "Air permit", [W air Value],
			        "Community", [W community Value],
			        0
			)
			```
		formatString: 0
		isHidden

	/// Average of the switched-on components that have a value, 0-100. Use with the pillar in the row or axis.
	measure 'Pillar Score' = ```
			AVERAGE ( county_factor_score[factor_score] )
			```
		formatString: 0

	/// Pillar scores weighted by the pillar sliders (0-100).
	measure 'My Score' = ```
			VAR p =
			    ADDCOLUMNS (
			        ALLSELECTED ( county_factor_score[pillar] ),
			        "@w", [Weight For Pillar],
			        "@s", CALCULATE ( AVERAGE ( county_factor_score[factor_score] ) )
			    )
			-- A pillar counts only if the county has at least one switched-on component with a
			-- value; otherwise it is left out of BOTH the top and the bottom, never counted as 0.
			VAR numer = SUMX ( p, IF ( ISBLANK ( [@s] ), 0, [@w] * [@s] ) )
			VAR denom = SUMX ( p, IF ( ISBLANK ( [@s] ), 0, [@w] ) )
			RETURN
			    DIVIDE ( numer, denom )
			```
		formatString: 0

	/// 1 = best county among those currently shown.
	measure 'My Rank' = ```
			IF ( ISBLANK ( [My Score] ), BLANK (),
			     RANKX ( ALLSELECTED ( County[county_name] ), [My Score], , DESC, DENSE ) )
			```
		formatString: 0

	/// Share of your slider weight the county has data for. Below 100% means a whole pillar was missing and the score is based on the rest.
	measure 'Weight Used %' = ```
			VAR p =
			    ADDCOLUMNS (
			        ALLSELECTED ( county_factor_score[pillar] ),
			        "@w", [Weight For Pillar],
			        "@s", CALCULATE ( AVERAGE ( county_factor_score[factor_score] ) )
			    )
			RETURN
			    DIVIDE (
			        SUMX ( p, IF ( ISBLANK ( [@s] ), 0, [@w] ) ),
			        SUMX ( p, [@w] )
			    )
			```
		formatString: 0%

	/// Gas supply pillar score for the county (0-100).
	measure 'Gas supply score' = ```
			CALCULATE ( AVERAGE ( county_factor_score[factor_score] ), county_factor_score[pillar] = "Gas supply" )
			```
		formatString: 0

	/// Grid connection pillar score for the county (0-100).
	measure 'Grid connection score' = ```
			CALCULATE ( AVERAGE ( county_factor_score[factor_score] ), county_factor_score[pillar] = "Grid connection" )
			```
		formatString: 0

	/// Site control pillar score for the county (0-100).
	measure 'Site control score' = ```
			CALCULATE ( AVERAGE ( county_factor_score[factor_score] ), county_factor_score[pillar] = "Site control" )
			```
		formatString: 0

	/// Air permit pillar score for the county (0-100).
	measure 'Air permit score' = ```
			CALCULATE ( AVERAGE ( county_factor_score[factor_score] ), county_factor_score[pillar] = "Air permit" )
			```
		formatString: 0

	/// Community pillar score for the county (0-100).
	measure 'Community score' = ```
			CALCULATE ( AVERAGE ( county_factor_score[factor_score] ), county_factor_score[pillar] = "Community" )
			```
		formatString: 0

	/// 0-100 score for the single factor picked on the Single factor page.
	measure 'Layer Score' = ```
			IF ( HASONEVALUE ( county_factor_score[factor_label] ),
			     AVERAGE ( county_factor_score[factor_score] ) )
			```
		formatString: 0

	/// The underlying number before scaling, in the factor's own unit.
	measure 'Layer Raw Value' = ```
			IF ( HASONEVALUE ( county_factor_score[factor_label] ),
			     AVERAGE ( county_factor_score[raw_value] ) )
			```
		formatString: #,##0.00

	measure 'Layer Title' = ```
			SELECTEDVALUE ( county_factor_score[factor_label], "Pick one factor on the left" )
			    & IF ( HASONEVALUE ( county_factor_score[unit] ), " (" & SELECTEDVALUE ( county_factor_score[unit] ) & ")", "" )
			```

	measure 'Detail Title' = ```
			IF ( HASONEVALUE ( County[county_name] ), SELECTEDVALUE ( County[county_name] ) & " County",
			     "No county selected: on Score map, right-click a county, Drill through, County detail" )
			```

	measure 'Pipe Miles' = ```
			SUM ( pipeline_segment[miles] )
			```
		formatString: #,##0.0

	measure 'Plant MW' = ```
			SUM ( plant[nameplate_mw] )
			```
		formatString: #,##0


	partition County = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerName, DatabaseName, [Query = "SELECT c.county_fips, c.county_name, c.county_name + ' County, Texas' AS map_label, c.population, c.land_area_sqmi, a.ozone_class, a.nox_offset_ratio, a.nox_offset_cost_per_tpy, a.nox_credit_trades, a.land_parcel_coverage, a.land_industrial_acres, a.lng_terminal_count FROM dim.county c LEFT JOIN (SELECT county_fips, MAX(CASE WHEN attribute_key = 'ozone_classification' THEN value_text END) AS ozone_class, MAX(CASE WHEN attribute_key = 'nox_offset_ratio' THEN value_num END) AS nox_offset_ratio, MAX(CASE WHEN attribute_key = 'nox_offset_cost_per_tpy' THEN value_num END) AS nox_offset_cost_per_tpy, MAX(CASE WHEN attribute_key = 'nox_credit_trades' THEN value_num END) AS nox_credit_trades, MAX(CASE WHEN attribute_key = 'land_parcel_coverage' THEN value_num END) AS land_parcel_coverage, MAX(CASE WHEN attribute_key = 'land_industrial_acres' THEN value_num END) AS land_industrial_acres, MAX(CASE WHEN attribute_key = 'lng_terminal_count' THEN value_num END) AS lng_terminal_count FROM fact.county_attribute GROUP BY county_fips) a ON a.county_fips = c.county_fips WHERE c.in_ercot = 1"]),
					Typed = Table.TransformColumnTypes(Source, {{"county_fips", type text},{"county_name", type text},{"map_label", type text},{"population", Int64.Type},{"land_area_sqmi", type number},{"ozone_class", type text},{"nox_offset_ratio", type number},{"nox_offset_cost_per_tpy", type number},{"nox_credit_trades", type number},{"land_parcel_coverage", type number},{"land_industrial_acres", type number},{"lng_terminal_count", type number}})
				in
					Typed

