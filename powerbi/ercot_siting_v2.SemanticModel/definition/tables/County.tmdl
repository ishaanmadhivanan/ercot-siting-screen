table County

	column county_fips
		dataType: string
		summarizeBy: none
		sourceColumn: county_fips

	column county_name
		dataType: string
		summarizeBy: none
		sourceColumn: county_name

	column map_label
		dataType: string
		dataCategory: County
		summarizeBy: none
		sourceColumn: map_label

	column population
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: population

	column land_area_sqmi
		dataType: double
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: land_area_sqmi

	column ozone_class
		dataType: string
		summarizeBy: none
		sourceColumn: ozone_class

	column nox_offset_ratio
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: nox_offset_ratio

	column nox_offset_cost_per_tpy
		dataType: double
		formatString: $#,##0
		summarizeBy: none
		sourceColumn: nox_offset_cost_per_tpy

	column nox_credit_trades
		dataType: double
		summarizeBy: none
		sourceColumn: nox_credit_trades

	column land_parcel_coverage
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: land_parcel_coverage

	column land_industrial_acres
		dataType: double
		summarizeBy: none
		sourceColumn: land_industrial_acres

	column lng_terminal_count
		dataType: double
		summarizeBy: none
		sourceColumn: lng_terminal_count

	column 'Ozone Status' = IF ( County[ozone_class] = "Attainment", "Attainment", "Nonattainment" )
		dataType: string
		summarizeBy: none


	/// Reads the slider for whichever factor is in the current row. Used by My Score.
	measure 'Weight For Factor' = ```
			SWITCH (
			    SELECTEDVALUE ( county_factor_score[factor_key] ),
			        "installed_mw", [W installed_mw Value],
			        "retiring_mw", [W retiring_mw Value],
			        "capacity_factor", [W capacity_factor Value],
			        "generation_trend", [W generation_trend Value],
			        "queue_congestion", [W queue_congestion Value],
			        "queue_attrition", [W queue_attrition Value],
			        "aging_thermal_mw", [W aging_thermal_mw Value],
			        "gas_queue_mw", [W gas_queue_mw Value],
			        "gas_capacity_factor", [W gas_capacity_factor Value],
			        "pop_density", [W pop_density Value],
			        "land_large_tract_share", [W land_large_tract_share Value],
			        "land_owner_density", [W land_owner_density Value],
			        "land_parcels_500ac", [W land_parcels_500ac Value],
			        "ozone_severity", [W ozone_severity Value],
			        "gas_pipe_miles", [W gas_pipe_miles Value],
			        "gas_pipe_large_miles", [W gas_pipe_large_miles Value],
			        "gas_pipe_interstate_miles", [W gas_pipe_interstate_miles Value],
			        "gas_pipe_operators", [W gas_pipe_operators Value],
			        "gas_gathering_miles", [W gas_gathering_miles Value],
			        0
			)
			```
		formatString: 0

	/// Weighted average of the factor scores (0-100) using the sliders.
	measure 'My Score' = ```
			VAR f =
			    ADDCOLUMNS (
			        VALUES ( county_factor_score[factor_key] ),
			        "@w", [Weight For Factor],
			        "@s", CALCULATE ( AVERAGE ( county_factor_score[factor_score] ) )
			    )
			-- A positive weight rewards a high factor score; a negative weight rewards a low one.
			-- Factors a county has no score for are left out of BOTH the top and the bottom,
			-- so a missing value never counts as a zero.
			VAR numer =
			    SUMX ( f, IF ( ISBLANK ( [@s] ) || [@w] = 0, 0,
			                   IF ( [@w] > 0, [@w] * [@s], -[@w] * ( 100 - [@s] ) ) ) )
			VAR denom =
			    SUMX ( f, IF ( ISBLANK ( [@s] ), 0, ABS ( [@w] ) ) )
			RETURN
			    DIVIDE ( numer, denom )
			```
		formatString: 0.0

	/// 1 = best county among those currently shown.
	measure 'My Rank' = ```
			IF ( ISBLANK ( [My Score] ), BLANK (),
			     RANKX ( ALLSELECTED ( County[county_name] ), [My Score], , DESC, DENSE ) )
			```
		formatString: 0

	/// Share of your slider weight the county actually has data for. Below 100% means a factor was missing and the score is based on the rest.
	measure 'Weight Used %' = ```
			VAR f =
			    ADDCOLUMNS (
			        VALUES ( county_factor_score[factor_key] ),
			        "@w", [Weight For Factor],
			        "@s", CALCULATE ( AVERAGE ( county_factor_score[factor_score] ) )
			    )
			RETURN
			    DIVIDE (
			        SUMX ( f, IF ( ISBLANK ( [@s] ), 0, ABS ( [@w] ) ) ),
			        SUMX ( f, ABS ( [@w] ) )
			    )
			```
		formatString: 0%

	/// 0-100 score for the single factor picked on the Single factor page.
	measure 'Layer Score' = ```
			IF ( HASONEVALUE ( county_factor_score[factor_label] ),
			     AVERAGE ( county_factor_score[factor_score] ) )
			```
		formatString: 0.0

	/// The underlying number before scaling, in the factor's own unit.
	measure 'Layer Raw Value' = ```
			IF ( HASONEVALUE ( county_factor_score[factor_label] ),
			     AVERAGE ( county_factor_score[raw_value] ) )
			```
		formatString: #,##0.00

	measure 'Layer Title' = ```
			SELECTEDVALUE ( county_factor_score[factor_label], "Pick one factor on the left" )
			    & IF ( HASONEVALUE ( county_factor_score[unit] ), " (" & SELECTEDVALUE ( county_factor_score[unit] ) & ")", "" )
			```

	measure 'Pipe Miles' = ```
			SUM ( pipeline_segment[miles] )
			```
		formatString: #,##0.0

	measure 'Plant MW' = ```
			SUM ( plant[nameplate_mw] )
			```
		formatString: #,##0


	partition County = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerName, DatabaseName, [Query = "SELECT c.county_fips, c.county_name, c.county_name + ' County, Texas' AS map_label, c.population, c.land_area_sqmi, a.ozone_class, a.nox_offset_ratio, a.nox_offset_cost_per_tpy, a.nox_credit_trades, a.land_parcel_coverage, a.land_industrial_acres, a.lng_terminal_count FROM dim.county c LEFT JOIN (SELECT county_fips, MAX(CASE WHEN attribute_key = 'ozone_classification' THEN value_text END) AS ozone_class, MAX(CASE WHEN attribute_key = 'nox_offset_ratio' THEN value_num END) AS nox_offset_ratio, MAX(CASE WHEN attribute_key = 'nox_offset_cost_per_tpy' THEN value_num END) AS nox_offset_cost_per_tpy, MAX(CASE WHEN attribute_key = 'nox_credit_trades' THEN value_num END) AS nox_credit_trades, MAX(CASE WHEN attribute_key = 'land_parcel_coverage' THEN value_num END) AS land_parcel_coverage, MAX(CASE WHEN attribute_key = 'land_industrial_acres' THEN value_num END) AS land_industrial_acres, MAX(CASE WHEN attribute_key = 'lng_terminal_count' THEN value_num END) AS lng_terminal_count FROM fact.county_attribute GROUP BY county_fips) a ON a.county_fips = c.county_fips WHERE c.in_ercot = 1"]),
					Typed = Table.TransformColumnTypes(Source, {{"county_fips", type text},{"county_name", type text},{"map_label", type text},{"population", Int64.Type},{"land_area_sqmi", type number},{"ozone_class", type text},{"nox_offset_ratio", type number},{"nox_offset_cost_per_tpy", type number},{"nox_credit_trades", type number},{"land_parcel_coverage", type number},{"land_industrial_acres", type number},{"lng_terminal_count", type number}})
				in
					Typed

