table 'W gas_pipe_large_miles'
	isHidden

	column 'Large gas pipe (20 in and up)'
		dataType: int64
		sourceColumn: [Value]
		summarizeBy: none

	measure 'W gas_pipe_large_miles Value' = ```
			SELECTEDVALUE ( 'W gas_pipe_large_miles'[Large gas pipe (20 in and up)], 0 )
			```
		formatString: 0

	partition 'W gas_pipe_large_miles' = calculated
		mode: import
		source = GENERATESERIES ( 0, 10, 1 )
