table pipeline_segment

	column county_fips
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: county_fips

	column operator_name
		dataType: string
		summarizeBy: none
		sourceColumn: operator_name

	column system_name
		dataType: string
		summarizeBy: none
		sourceColumn: system_name

	column diameter_in
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: diameter_in

	column interstate
		dataType: string
		summarizeBy: none
		sourceColumn: interstate

	column miles
		dataType: double
		formatString: #,##0.0
		summarizeBy: sum
		sourceColumn: miles



	partition pipeline_segment = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerName, DatabaseName),
					View = Source{[Schema = "rpt", Item = "pbi_pipeline_segment"]}[Data],
					Kept = Table.SelectColumns(View, {"county_fips", "operator_name", "system_name", "diameter_in", "interstate", "miles"}),
					Typed = Table.TransformColumnTypes(Kept, {{"county_fips", type text},{"operator_name", type text},{"system_name", type text},{"diameter_in", type number},{"interstate", type text},{"miles", type number}})
				in
					Typed

