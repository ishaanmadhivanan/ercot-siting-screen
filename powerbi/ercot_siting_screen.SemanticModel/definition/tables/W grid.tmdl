		formatString: 0
		sourceColumn: [Value]
		summarizeBy: none

		extendedProperty ParameterMetadata =
				{
				  "version": 0
				}

	measure 'W grid Value' = ```
			SELECTEDVALUE ( 'W grid'[Grid connection], 5 )
			```
